rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      // Simplified admin check for this demo: any signed-in user is an admin 
      // or we check for a specific email if provided.
      return isSignedIn() && (request.auth.token.email_verified == true);
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // User Entity Validation
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'descriptors', 'createdAt'])
        && data.name is string && data.name.size() <= 100
        && data.descriptors is list && data.descriptors.size() > 0 
        && data.createdAt is timestamp;
    }

    // Attendance Entity Validation
    function isValidAttendance(data) {
      return data.keys().hasAll(['userId', 'name', 'timestamp'])
        && data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.timestamp is timestamp;
    }

    // Match Blocks
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidUser(request.resource.data);
      allow update: if isAdmin() && isValidUser(request.resource.data) 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'descriptors', 'phone', 'imagePath']);
      allow delete: if isAdmin();
    }

    match /attendance/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidAttendance(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
